#T5
def CalculateScore(likes, saves,comments):
    score = likes * 2 + saves * 3 + comments
    return score
while True:
    try:
        m=int(input("请输入笔记数："))
        if m < 0:
            print("笔记数不能为负，请重新输入。")
            continue
        break
    except ValueError:
        print("请输入一个整数。")
nums=[]
for i in range(m):
    print("第", i+1, "篇笔记的数据")
    likes=int(input("点赞数: "))
    saves=int(input("收藏数: "))
    comments=int(input("评论数: "))
    score = CalculateScore(likes, saves, comments)
    nums.append(score)
nums.sort(reverse=True)  # 降序排序
for i, score in enumerate(nums, start=1):
    print(f"第 {i} 名: {score}分")

    
